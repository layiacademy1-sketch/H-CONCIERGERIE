rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@h-conciergerie.com';
    }

    function isValidMember(data) {
      return data.keys().hasAll(['firstName', 'name', 'phone', 'email', 'pseudo', 'status', 'date_joined']) &&
             data.keys().size() <= 15 &&
             data.firstName is string && data.firstName.size() >= 2 && data.firstName.size() <= 100 &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30 &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 150 &&
             data.pseudo is string && data.pseudo.size() >= 2 && data.pseudo.size() <= 50 &&
             data.status is string && (data.status == 'en_attente_paiement' || data.status == 'membre_actif' || data.status == 'expiré') &&
             data.date_joined is string;
    }

    match /members/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(uid) && 
                      isValidId(uid) &&
                      isValidMember(request.resource.data) && 
                      request.resource.data.status == 'en_attente_paiement';
                      
      allow update: if (isOwner(uid) && 
                      isValidId(uid) &&
                      isValidMember(request.resource.data) && 
                      request.resource.data.status == resource.data.status) || isAdmin();
                      
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
