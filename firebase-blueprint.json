{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "Information about a registered member, including their registration status, phone, email, and subscription payment details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "firstName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "pseudo": { "type": "string" },
        "status": { "type": "string", "enum": ["en_attente_paiement", "membre_actif", "expiré"] },
        "date_joined": { "type": "string" },
        "date_paiement": { "type": "string" },
        "montant_paye": { "type": "number" },
        "stripe_session_id": { "type": "string" },
        "abonnement": { "type": "string" }
      },
      "required": ["uid", "name", "firstName", "phone", "email", "pseudo", "status"]
    }
  },
  "firestore": {
    "/members/{uid}": {
      "schema": "Member",
      "description": "Collection of members registered with authentication."
    }
  }
}
